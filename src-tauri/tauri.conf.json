{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Recon",
  "version": "../package.json",
  "identifier": "com.recon.utility",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Recon \u2022 Stretched Resolution & Utility",
        "width": 1180,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "overlay",
        "title": "",
        "url": "index.html#overlay",
        "fullscreen": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/trnfetch"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.icns"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/youssefvdel/Recon/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMTBGNDc1NUYxN0NDMTIKUldRU3pCZGZkZlFRMi9RSHBSUzZYTWZGNjJWQXQ1Mk1RSkg0a0Fia080WVBlbThBU0NhVDltY3AK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
